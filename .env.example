# RevenueLab API credentials — NEVER commit real values
REVENUELAB_USERNAME=
REVENUELAB_PASSWORD=

# RevenueLab Get statistics endpoint from the current API documentation/account.
# The documentation confirms the required query parameters: dateFrom, dateTo,
# currency, groupBy, sources, withFullSources. Keep this value server-side.
REVENUELAB_STATS_URL=

# RevenueLab documentation uses Bearer-token authentication for earnings and
# id_token-style authorization for the statistics method.
REVENUELAB_EARNINGS_AUTH_PREFIX=Bearer
REVENUELAB_STATS_AUTH_PREFIX=id_token

# Optional extra gate for the private RawEdge analytics route.
RAWEDGE_ADMIN_KEY=
